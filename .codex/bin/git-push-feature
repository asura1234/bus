#!/bin/sh
set -eu
[ "$#" -eq 2 ] || { echo 'usage: git-push-feature WORKTREE refs/heads/TASK-BRANCH' >&2; exit 2; }
worktree=$1
destination=$2
case "$worktree" in
  /Users/dylanliu/work/bus-chore-codex-allowlist) ;;
  *) echo 'unreviewed worktree' >&2; exit 2 ;;
esac
case "$destination" in
  refs/heads/feat/*|refs/heads/fix/*|refs/heads/chore/*|refs/heads/docs/*) ;;
  *) echo 'destination must be a task branch' >&2; exit 2 ;;
esac
branch=$(/opt/homebrew/bin/git -C "$worktree" symbolic-ref --quiet --short HEAD)
[ "$destination" = "refs/heads/$branch" ] || { echo 'destination must equal current branch' >&2; exit 2; }
exec /opt/homebrew/bin/git -C "$worktree" push -u origin "HEAD:$destination"
