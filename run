#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    echo "Usage: ./run dev [Bus arguments]" >&2
    echo "       ./run prod [Bus arguments]" >&2
    echo "       ./run dev-control <command> [arguments]" >&2
    echo "" >&2
    echo "dev builds the dev variant (cargo feature dev-tools: the TUI driver and other" >&2
    echo "test tooling) and launches it with --dev. prod builds the release variant, the" >&2
    echo "one npm ships, which leaves that tooling out, and launches it as is." >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  ./run dev" >&2
    echo "  ./run dev resume --last" >&2
    echo "  ./run dev sessions" >&2
    echo "  ./run dev-control agent read 3 --source recent --lines 80" >&2
}

# Cargo writes where CARGO_TARGET_DIR (or CARGO_BUILD_TARGET_DIR) points, so
# launch that fresh build, never a stale one under target/.
cargo_target_dir() {
    printf '%s\n' "${CARGO_TARGET_DIR:-${CARGO_BUILD_TARGET_DIR:-$REPO_ROOT/target}}"
}

case "${1:-}" in
    dev)
        shift
        cd "$REPO_ROOT"
        cargo build --locked --bin bus --features dev-tools
        exec "$(cargo_target_dir)/debug/bus" --dev "$@"
        ;;
    prod)
        shift
        cd "$REPO_ROOT"
        cargo build --locked --release --bin bus
        exec "$(cargo_target_dir)/release/bus" "$@"
        ;;
    dev-control)
        shift
        cd "$REPO_ROOT"
        # Always the default debug build, as the live Bus runs it: agents set
        # CARGO_TARGET_DIR for their own builds, which must not become the CLI.
        binary="$REPO_ROOT/target/debug/bus"
        if [[ ! -x "$binary" ]]; then
            echo "Bus debug binary is missing; run './run dev' (or 'cargo build --locked --bin bus --features dev-tools') once before dev-control." >&2
            exit 1
        fi
        exec "$binary" --dev "$@"
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage
        exit 2
        ;;
esac
