#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    echo "Usage: ./run dev [Bus arguments]" >&2
    echo "       ./run dev-control <command> [arguments]" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  ./run dev" >&2
    echo "  ./run dev resume --last" >&2
    echo "  ./run dev sessions" >&2
    echo "  ./run dev-control agent read 3 --source recent --lines 80" >&2
}

case "${1:-}" in
    dev)
        shift
        cd "$REPO_ROOT"
        cargo build --locked --bin herdr
        exec "$REPO_ROOT/target/debug/herdr" --bus --dev "$@"
        ;;
    dev-control)
        shift
        cd "$REPO_ROOT"
        binary="$REPO_ROOT/target/debug/herdr"
        if [[ ! -x "$binary" ]]; then
            echo "Bus debug binary is missing; run './run dev' or 'cargo build --locked --bin herdr' once before dev-control." >&2
            exit 1
        fi
        exec "$binary" --bus --dev "$@"
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage
        exit 2
        ;;
esac
