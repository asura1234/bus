#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    echo "Usage: ./run dev [Bus arguments]" >&2
    echo "       ./run prod [Bus arguments]" >&2
    echo "       ./run dev-control <command> [arguments]" >&2
    echo "       ./run tui <verb> [arguments]" >&2
    echo "       ./run install-skills [--yes]" >&2
    echo "       ./run test [--full] [--base REF] [--plan]" >&2
    echo "       ./run remove-skills [--yes]" >&2
    echo "" >&2
    echo "dev builds the dev variant (cargo feature dev-tools: the TUI driver and other" >&2
    echo "test tooling) and launches it with --dev. prod builds the release variant, the" >&2
    echo "one npm ships, which leaves that tooling out, and launches it as is." >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  ./run dev" >&2
    echo "  ./run dev resume --last" >&2
    echo "  ./run dev sessions" >&2
    echo "  ./run dev-control agent read 3 --source recent --lines 80" >&2
    echo "  ./run tui start" >&2
    echo "  ./run install-skills --yes" >&2
    echo "  ./run remove-skills --yes" >&2
}

# Build bus and print the executable Cargo reports for it. Cargo alone knows
# its target dir (CARGO_TARGET_DIR, build.target-dir in any config, ...), so
# launching its report never runs a stale binary from somewhere else.
build_bus() {
    local output executable
    output=$(cargo build --locked --message-format=json-render-diagnostics "$@") || return $?
    # Decode Cargo's JSON messages properly: a path may hold escaped quotes.
    executable=$(printf '%s\n' "$output" | python3 -I -c '
import json, sys
found = ""
for line in sys.stdin:
    try:
        message = json.loads(line)
    except ValueError:
        continue
    target = message.get("target") or {}
    if message.get("reason") == "compiler-artifact" and message.get("executable") \
            and target.get("name", "bus") == "bus":
        found = message["executable"]
print(found)
')
    if [[ -z "$executable" ]]; then
        echo "Cargo reported no bus executable for this build." >&2
        return 1
    fi
    printf '%s\n' "$executable"
}

case "${1:-}" in
    test)
        shift
        cd "$REPO_ROOT"
        python="$REPO_ROOT/temp/gate-tools/python/bin/python"
        [[ -x "$python" ]] || python=python3
        exec "$python" "$REPO_ROOT/skills/gate-and-fix/scripts/suite_run.py" "$@"
        ;;
    dev)
        shift
        cd "$REPO_ROOT"
        binary=$(build_bus --bin bus --features dev-tools) || exit $?
        exec "$binary" --dev "$@"
        ;;
    prod)
        shift
        cd "$REPO_ROOT"
        binary=$(build_bus --release --bin bus) || exit $?
        exec "$binary" "$@"
        ;;
    dev-control)
        shift
        cd "$REPO_ROOT"
        # The default debug build, which ./run dev uses when no target dir is
        # set: agents set CARGO_TARGET_DIR for their own builds, which must not
        # become the CLI that talks to the live Bus.
        binary="$REPO_ROOT/target/debug/bus"
        if [[ ! -x "$binary" ]]; then
            echo "Bus debug binary is missing; run './run dev' (or 'cargo build --locked --bin bus --features dev-tools') once before dev-control." >&2
            exit 1
        fi
        exec "$binary" --dev "$@"
        ;;
    tui)
        shift
        cd "$REPO_ROOT"
        # The dev variant, as ./run dev builds it, but always into a
        # tui-driver dir of its own, even under an inherited target dir that
        # ./run dev shares: a scratch Bus never runs from, and ./run tui never
        # rebuilds, the debug binary the developer's Bus runs.
        binary=$(CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$REPO_ROOT/target}/tui-driver" \
            build_bus --bin bus --features dev-tools) || exit $?
        exec "$binary" --dev tui "$@"
        ;;
    install-skills|remove-skills)
        command="$1"
        shift
        cd "$REPO_ROOT"
        case "$command" in
            install-skills) verb=install ;;
            remove-skills) verb=remove ;;
        esac
        exec python3 -I "$REPO_ROOT/tools/install_skills.py" "$verb" "$@"
        ;;
    -h|--help)
        usage
        ;;
    *)
        usage
        exit 2
        ;;
esac
