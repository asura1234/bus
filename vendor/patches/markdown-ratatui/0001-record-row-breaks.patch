+/// How a prepared row continues the row above it.
+///
+/// Copy and selection code rejoins rows from these values: a hard break is a
+/// line end, a continuation joins directly, and an elided separator joins with
+/// one space.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum RowWrap {
+    /// The row starts a block, a source line, or follows a hard break.
+    #[default]
+    HardBreak,
+    /// Wrapping split a token here; no text sits between the two rows.
+    Continuation,
+    /// Wrapping replaced whitespace here; one space joins the two rows.
+    ContinuationElidedSep,
+}
