{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "assignment",
        "handover"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "ts": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "author",
        "reviewer",
        "tester",
        "explorer",
        "investigator",
        "operator",
        "orchestrator"
      ]
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "task",
    "ts",
    "role",
    "agent",
    "orchestrator",
    "sources",
    "data"
  ],
  "additionalProperties": false,
  "data_schemas": {
    "assignment": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "message_id"
      ],
      "additionalProperties": false
    },
    "handover": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "old_agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "name",
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "compaction",
            "unavailable",
            "other"
          ]
        }
      },
      "required": [
        "message_id",
        "old_agent",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
