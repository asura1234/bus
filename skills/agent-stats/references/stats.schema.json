{
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer","enum": [1]},
    "id": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{64}$"},
    "kind": {"type": "string","minLength": 1,"enum": ["assignment","handover","pr","review","root_cause","run","coverage","delta","workflow","delivery","compaction","phase","escape","assignment_end"]},
    "task": {"type": "string","minLength": 1,"pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "ts": {"type": ["string","null"],"format": "date-time"},
    "role": {"type": "string","minLength": 1,"enum": ["author","reviewer","tester","explorer","investigator","operator","orchestrator"]},
    "agent": {"type": "object","properties": {"id": {"type": "string","minLength": 1},"name": {"type": "string","minLength": 1},"provider": {"type": "string","minLength": 1},"model": {"type": "string","minLength": 1}},"required": ["id","name","provider","model"],"additionalProperties": false},
    "orchestrator": {"type": "object","properties": {"id": {"type": "string","minLength": 1},"name": {"type": "string","minLength": 1},"provider": {"type": "string","minLength": 1},"model": {"type": "string","minLength": 1}},"required": ["id","name","provider","model"],"additionalProperties": false},
    "sources": {"type": "array","minItems": 1,"items": {"type": "object","properties": {"path": {"type": "string","minLength": 1},"sha256": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{64}$"},"locator": {"type": "string","minLength": 1}},"required": ["path","sha256","locator"],"additionalProperties": false}},
    "data": {"type": "object"}
  },
  "required": ["schema_version","id","kind","task","ts","role","agent","orchestrator","sources","data"],
  "additionalProperties": false,
  "data_schemas": {
    "assignment": {"type": "object","properties": {"message_id": {"type": ["integer","null"],"minimum": 1},"room_id": {"type": "integer","minimum": 0},"workspace_snapshot": {"type": ["string","null"]}},"required": ["message_id","room_id","workspace_snapshot"],"additionalProperties": false},
    "handover": {"type": "object","properties": {"message_id": {"type": ["integer","null"],"minimum": 1},"old_agent": {"type": "object","properties": {"id": {"type": "string","minLength": 1},"name": {"type": "string","minLength": 1},"provider": {"type": "string","minLength": 1},"model": {"type": "string","minLength": 1}},"required": ["id","name","provider","model"],"additionalProperties": false},"reason": {"type": "string","minLength": 1,"enum": ["compaction","unavailable","other","stopped"]},"room_id": {"type": "integer","minimum": 0},"workspace_snapshot": {"type": ["string","null"]}},"required": ["message_id","old_agent","reason","room_id","workspace_snapshot"],"additionalProperties": false},
    "pr": {"type": "object","properties": {"number": {"type": "integer","minimum": 1},"title": {"type": "string","minLength": 1},"url": {"type": "string","minLength": 1},"branch": {"type": "string","minLength": 1},"created_at": {"type": "string","minLength": 1,"format": "date-time"},"merged_at": {"type": "string","minLength": 1,"format": "date-time"},"merge_sha": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"},"head": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"},"github_author": {"type": "string","minLength": 1},"commit_count": {"type": "integer","minimum": 0},"commits": {"type": "array","items": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"}},"additions": {"type": "integer","minimum": 0},"deletions": {"type": "integer","minimum": 0},"files": {"type": "integer","minimum": 0},"authors": {"type": "array","items": {"type": "string","minLength": 1}}},"required": ["number","title","url","branch","created_at","merged_at","merge_sha","head","github_author","commit_count","commits","additions","deletions","files","authors"],"additionalProperties": false},
    "review": {"type": "object","properties": {"round": {"type": "integer","minimum": 1},"head": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"},"branch": {"type": "string","minLength": 1},"date": {"type": "string","minLength": 1,"pattern": "^\\d{4}-\\d\\d-\\d\\d$"},"verdict": {"type": "string","minLength": 1,"enum": ["Ready","Needs Refinement","Abandon"]},"findings": {"type": "array","items": {"type": "object","properties": {"id": {"type": "string","minLength": 1},"dimension": {"type": ["string","null"]},"location": {"type": ["string","null"]},"inherited": {"type": "boolean"}},"required": ["id","dimension","location","inherited"],"additionalProperties": false}}},"required": ["round","head","branch","date","verdict","findings"],"additionalProperties": false},
    "root_cause": {"type": "object","properties": {"claim_id": {"type": "string","minLength": 1},"adjudication": {"type": "string","minLength": 1},"head": {"type": ["string","null"]},"outcome": {"type": "string","minLength": 1,"enum": ["APPLY","REJECT","FLAG","WITHDRAWN"]},"reviewers": {"type": "array","items": {"type": "string","minLength": 1}},"source_refs": {"type": "array","items": {"type": "object","properties": {"reviewer": {"type": "string","minLength": 1},"round": {"type": ["integer","null"],"minimum": 0},"finding_id": {"type": ["string","null"]}},"required": ["reviewer","round","finding_id"],"additionalProperties": false}},"run_ids": {"type": "array","items": {"type": "string","pattern": "^[0-9a-f]{64}$"}},"locations": {"type": "array","items": {"type": "string","minLength": 1}}},"required": ["claim_id","adjudication","head","outcome","reviewers","source_refs","run_ids","locations"],"additionalProperties": false},
    "run": {"type": "object","properties": {"kind": {"type": "string","minLength": 1,"enum": ["gate","e2e","live"]},"head": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"},"result": {"type": "string","minLength": 1,"enum": ["PASS","FAIL","SKIPPED","INTERRUPTED","INCOMPLETE"]},"duration_ms": {"type": ["integer","null"],"minimum": 0},"failure_cause": {"type": ["string","null"],"enum": ["code","flaky","stale-test","environment",null]},"full": {"type": ["boolean","null"]},"lanes": {"type": "array","items": {"type": "object","properties": {"name": {"type": "string","minLength": 1},"result": {"type": "string","minLength": 1,"enum": ["PASS","FAIL","SKIPPED","NOT_RUN"]},"duration_ms": {"type": ["integer","null"],"minimum": 0}},"required": ["name","result","duration_ms"],"additionalProperties": false}},"started_at": {"type": ["string","null"],"format": "date-time"},"finished_at": {"type": ["string","null"],"format": "date-time"},"slot_wait_ms": {"type": ["integer","null"],"minimum": 0},"failing_test_ids": {"type": "array","items": {"type": "string","minLength": 1}},"wrapped_sources": {"type": "array","items": {"type": "string","pattern": "^[0-9a-f]{64}$"}}},"required": ["kind","head","result","duration_ms","failure_cause","full","lanes","started_at","finished_at","slot_wait_ms","failing_test_ids"],"additionalProperties": false},
    "coverage": {"type": "object","properties": {"field": {"type": "string","minLength": 1},"reason": {"type": "string","minLength": 1}},"required": ["field","reason"],"additionalProperties": false},
    "delta": {"type": "object","properties": {"ready_head": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"},"merged_head": {"type": "string","minLength": 1,"pattern": "^[0-9a-f]{7,64}$"},"files": {"type": "integer","minimum": 0},"additions": {"type": "integer","minimum": 0},"deletions": {"type": "integer","minimum": 0}},"required": ["ready_head","merged_head","files","additions","deletions"],"additionalProperties": false},
    "workflow": {"type": "object","properties": {"text": {"type": "string","minLength": 1},"event": {"type": "string","minLength": 1,"enum": ["ownership","handover","rebase","compaction","merged"]}},"required": ["text","event"],"additionalProperties": false},
    "delivery": {"type": "object","properties": {"message_id": {"type": "integer","minimum": 1},"request_id": {"type": "integer","minimum": 1},"stage": {"type": "string","minLength": 1,"enum": ["queued","submitting","awaiting_start","delivered","joined","replied","abandoned"]},"reason": {"type": ["string","null"]}},"required": ["message_id","request_id","stage","reason"],"additionalProperties": false},
    "compaction": {"type": "object","properties": {"count": {"type": "integer","minimum": 0},"last_at_ms": {"type": ["integer","null"],"minimum": 0}},"required": ["count","last_at_ms"],"additionalProperties": false},
    "phase": {"type": "object","properties": {"phase": {"type": "string","enum": ["work","waiting_review","in_review","gate","waiting_build_slot"]},"transition": {"type": "string","enum": ["start","end"]},"start_id": {"type": ["string","null"],"pattern": "^[0-9a-f]{64}$"},"duration_ms": {"type": ["integer","null"],"minimum": 0},"artifact_sha": {"type": ["string","null"],"pattern": "^[0-9a-f]{64}$"}},"required": ["phase","transition","start_id","duration_ms","artifact_sha"],"additionalProperties": false},
    "escape": {"type": "object","properties": {"ready_head": {"type": "string","pattern": "^[0-9a-f]{7,64}$"},"defect_head": {"type": "string","pattern": "^[0-9a-f]{7,64}$"},"claim_event": {"type": "string","pattern": "^[0-9a-f]{64}$"},"locations": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 1}},"detected_by": {"type": "array","minItems": 1,"items": {"type": "string","enum": ["review","gate","live"]}},"proof": {"type": "string","enum": ["unchanged-cited-files"]}},"required": ["ready_head","defect_head","claim_event","locations","detected_by","proof"],"additionalProperties": false},
    "assignment_end": {"type": "object","properties": {"assignment_id": {"type": "string","pattern": "^[0-9a-f]{64}$"},"outcome": {"type": "string","enum": ["completed","stopped_early","replaced","cancelled"]},"proven": {"type": "boolean"},"reason": {"type": "string","minLength": 1},"message_ids": {"type": "array","items": {"type": "integer","minimum": 1}}},"required": ["assignment_id","outcome","proven","reason","message_ids"],"additionalProperties": false}
  }
}
